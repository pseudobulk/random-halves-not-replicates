# Copy to config.env and edit. Read by pipelines/*.sh (sourced) and by code/config.py.
# Environment variables of the same name override these values.

# Raw public data, laid out as pipelines/download.sh writes it (README, "Data").
DATA_ROOT=/path/to/data
# Tahoe-100M and the PIE_tahoe100m files (normally ${DATA_ROOT}/tahoe).
TAHOE_ROOT=${DATA_ROOT}/tahoe
# Intermediate arrays and per-analysis outputs (several hundred GB for the Tahoe and CD4 aggregates).
WORK=/path/to/work
# Where collect_figdata copies the small result files; the repository's data/ holds the copies used for the paper.
FIGDATA=${WORK}/figdata
# Worker processes for the extraction scripts.
WORKERS=16
# Python interpreters: analysis environment, and a separate one with cell-eval 0.8.2.
PYTHON=python3
CELLEVAL_PYTHON=python3
